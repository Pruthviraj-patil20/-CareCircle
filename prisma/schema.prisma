generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  families      FamilyMember[]
  tasksCreated      Task[]             @relation("tasksCreated")
  taskAssignments   TaskAssignment[]   @relation("taskAssignments")
  taskAssignedBy    TaskAssignment[]   @relation("taskAssignedBy")

  eventsCreated     Event[]            @relation("eventsCreated")
  eventParticipants EventParticipant[] @relation("eventParticipants")
  eventAssignedBy   EventParticipant[] @relation("eventAssignedBy")

  notifications     Notification[]
  notificationPref  NotificationPreference?
  documentsCreated    Document[]           @relation("documentsCreated")
  documentPermissions DocumentPermission[]
  announcementsCreated          Announcement[]          @relation("announcementsCreated")
  announcementComments          AnnouncementComment[]
  announcementReads             AnnouncementRead[]
  emergencyContactsCreated      EmergencyContact[]      @relation("emergencyContactsCreated")
  emergencyInstructionsCreated  EmergencyInstruction[]  @relation("emergencyInstructionsCreated")
  auditLogs                     AuditLog[]
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
  CAREGIVER
}

model Family {
  id          String             @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  
  members     FamilyMember[]
  invitations FamilyInvitation[]
  tasks       Task[]
  events      Event[]
  documents   Document[]
  announcements         Announcement[]
  emergencyContacts     EmergencyContact[]
  emergencyInstructions EmergencyInstruction[]
  auditLogs             AuditLog[]
}

model FamilyMember {
  id        String     @id @default(cuid())
  familyId  String
  userId    String
  role      FamilyRole @default(MEMBER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

model FamilyInvitation {
  id        String     @id @default(cuid())
  familyId  String
  email     String
  role      FamilyRole @default(MEMBER)
  token     String     @unique
  expires   DateTime
  createdAt DateTime   @default(now())
  
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, email])
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model InviteToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime
  role    UserRole @default(USER)

  @@unique([email, token])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  familyId    String
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("tasksCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignments TaskAssignment[]
  reminders   TaskReminder[]
  escalations TaskEscalation[]
  auditLogs   TaskAuditLog[]
}

model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  assignedById String
  createdAt  DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation("taskAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User     @relation("taskAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskReminder {
  id        String   @id @default(cuid())
  taskId    String
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum EventType {
  FAMILY
  APPOINTMENT
  BIRTHDAY
  TRAVEL
  SCHOOL
  RENEWAL
  OTHER
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  type        EventType @default(OTHER)
  isAllDay    Boolean   @default(false)
  startTime   DateTime
  endTime     DateTime
  location    String?
  familyId    String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  family       Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("eventsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  participants EventParticipant[]
  reminders    EventReminder[]
}

model EventParticipant {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  assignedById String
  createdAt    DateTime @default(now())

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User  @relation("eventParticipants", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User  @relation("eventAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventReminder {
  id        String   @id @default(cuid())
  eventId   String
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE
  TASK_OVERDUE
  TASK_COMPLETED
  ESCALATION
  CALENDAR_REMINDER
  DOCUMENT_EXPIRY
  ANNOUNCEMENT
  FAMILY_INVITATION
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id           String  @id @default(cuid())
  userId       String  @unique
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)
  
  tasks        Boolean @default(true)
  calendar     Boolean @default(true)
  documents    Boolean @default(true)
  announcements Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EscalationChannel {
  EMAIL
  IN_APP
  BOTH
}

model TaskEscalation {
  id           String            @id @default(cuid())
  taskId       String
  afterMinutes Int
  notifyUserId String
  channel      EscalationChannel @default(BOTH)
  createdAt    DateTime          @default(now())

  task         Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAuditLog {
  id        String   @id @default(cuid())
  taskId    String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum DocumentCategory {
  INSURANCE
  PROPERTY
  EDUCATION
  VEHICLE
  FINANCIAL
  PERSONAL
}

enum DocumentPermissionType {
  VIEW
  DOWNLOAD
  EDIT
  DELETE
}

model Document {
  id          String           @id @default(cuid())
  familyId    String
  title       String
  description String?          @db.Text
  category    DocumentCategory @default(PERSONAL)
  fileKey     String
  fileName    String
  fileSize    Int
  mimeType    String
  expiryDate  DateTime?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  family      Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation("documentsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  permissions DocumentPermission[]
}

model DocumentPermission {
  id         String                 @id @default(cuid())
  documentId String
  userId     String
  permission DocumentPermissionType
  createdAt  DateTime               @default(now())

  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId, permission])
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

model Announcement {
  id          String               @id @default(cuid())
  familyId    String
  title       String
  content     String               @db.Text
  priority    AnnouncementPriority @default(NORMAL)
  isPinned    Boolean              @default(false)
  expiresAt   DateTime?
  attachments Json?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  family      Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author      User                  @relation("announcementsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  comments    AnnouncementComment[]
  reads       AnnouncementRead[]
}

model AnnouncementComment {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

enum EmergencyContactType {
  FAMILY_DOCTOR
  INSURANCE
  SERVICE
  PERSONAL
  OTHER
}

model EmergencyContact {
  id                 String               @id @default(cuid())
  familyId           String
  name               String
  type               EmergencyContactType @default(PERSONAL)
  relationship       String?
  phone              String
  alternatePhone     String?
  email              String?
  address            String?
  notes              String?              @db.Text
  sensitiveInfo      String?              @db.Text
  isEmergencyService Boolean              @default(false)
  createdById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  family             Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy          User                 @relation("emergencyContactsCreated", fields: [createdById], references: [id], onDelete: Cascade)
}

model EmergencyInstruction {
  id          String   @id @default(cuid())
  familyId    String
  title       String
  category    String   @default("GENERAL")
  content     String   @db.Text
  isSensitive Boolean  @default(false)
  priority    Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("emergencyInstructionsCreated", fields: [createdById], references: [id], onDelete: Cascade)
}

enum AuditLogAction {
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILED
  AUTH_LOGOUT
  AUTH_PASSWORD_RESET_REQUESTED
  AUTH_PASSWORD_RESET_COMPLETED

  FAMILY_CREATED
  FAMILY_UPDATED
  FAMILY_INVITATION_SENT
  FAMILY_INVITATION_ACCEPTED
  MEMBER_REMOVED
  ROLE_CHANGED
  PERMISSION_CHANGED

  DOCUMENT_UPLOADED
  DOCUMENT_VIEWED
  DOCUMENT_DOWNLOADED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED

  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  TASK_DELETED
  TASK_ESCALATION_CREATED
  TASK_ESCALATION_DELETED
  TASK_ESCALATED

  ANNOUNCEMENT_CREATED
  ANNOUNCEMENT_UPDATED
  ANNOUNCEMENT_DELETED

  EMERGENCY_CONTACT_CREATED
  EMERGENCY_CONTACT_UPDATED
  EMERGENCY_CONTACT_DELETED
  EMERGENCY_INSTRUCTION_CREATED
  EMERGENCY_INSTRUCTION_UPDATED
  EMERGENCY_INSTRUCTION_DELETED
}

model AuditLog {
  id          String         @id @default(cuid())
  familyId    String?
  userId      String?
  action      AuditLogAction
  entityType  String
  entityId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  family      Family?        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}


