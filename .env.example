# Database connection
DATABASE_URL="postgresql://user:password@localhost:5432/carecircle?schema=public"

# NextAuth Configuration
# Run `npx auth secret` to generate a secure secret, or use `openssl rand -base64 32`
AUTH_SECRET="your-super-secret-key-that-is-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
