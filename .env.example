# ==========================================
# CareCircle - Environment Configuration
# ==========================================

# 1. Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/carecircle?schema=public"

# 2. NextAuth.js v5 (Authentication & Session Security)
# Run `openssl rand -base64 32` or `npx auth secret` to generate a 32+ character secret
AUTH_SECRET="your-super-secret-key-that-is-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# 3. Google OAuth 2.0 (Optional - for Social Login)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. Email Dispatch via Resend (Transactional alerts & invitations)
RESEND_API_KEY="re_123456789"

# 5. Inngest (Background Jobs, Escalation Engine & Cron Reminders)
# For local development with Inngest Dev Server (`npx inngest-cli@latest dev`), set to 'local'
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY="local"

# 6. Object Storage (Cloudflare R2 / AWS S3 / MinIO)
# Optional in local development: if omitted, uploads fallback automatically to local disk (.storage/vault/)
S3_ACCESS_KEY_ID="your_s3_or_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_s3_or_r2_secret_access_key"
S3_BUCKET_NAME="carecircle-vault"
S3_REGION="us-east-1"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Cloudflare R2 specific aliases (if preferred over S3_ prefix)
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_ACCOUNT_ID=""
